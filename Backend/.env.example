# Copy this file to ".env" and fill in real values. .env is gitignored;
# this .env.example is committed, so NEVER put real secrets here.

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true

# Your Gmail address
EMAIL_HOST_USER=youraddress@gmail.com

# A Gmail APP PASSWORD (16 chars, NOT your normal password).
# Requires 2-Step Verification. Create at https://myaccount.google.com/apppasswords
EMAIL_HOST_PASSWORD=your-16-char-app-password

DEFAULT_FROM_EMAIL=SCSP <youraddress@gmail.com>
EMAIL_TIMEOUT=20

# Local dev without Gmail: use the console backend instead (prints OTP to terminal)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# --- Production (set these on your host, e.g. Render) ---
# SECRET_KEY=generate-a-long-random-string
# DEBUG=false
# ALLOWED_HOSTS=your-backend.onrender.com
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app
# DATABASE_URL=postgres://...   (optional; omit to use SQLite)
